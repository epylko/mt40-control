# Meraki API Configuration
MERAKI_API_KEY=your_api_key_here
MERAKI_ORG_ID=your_org_id
MERAKI_NETWORK_NAME=Your Network
MT40_SERIAL=XXXX-XXXX-XXXX
MT30_SERIAL=XXXX-XXXX-XXXX

# Webhook Server Configuration
WEBHOOK_PORT=3001
WEBHOOK_HOST=0.0.0.0

# Web UI Authentication
UI_USERNAME=admin
UI_PASSWORD=change_me

# Button Press Timeout (seconds to wait for second long press to turn off)
LONG_PRESS_TIMEOUT=20

# Scheduler misfire grace time (seconds): how late a job can fire and still run
MISFIRE_GRACE_TIME='300'

# Debug Mode: 'webhook', 'schedule', 'all', or empty for no debug
DEBUG_MODE=
